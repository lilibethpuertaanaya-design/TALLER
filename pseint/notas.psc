Algoritmo notas
	Definir n1,n2,nu3_min Como Real;
	Escribir " digite nota corte 1 (20%)"
	leer n1
	Escribir "digite nota corte 2 (20%)"
	leer n2
	n3_min= (3 - (n1*0 + n2*0.2)) /0.6
	Escribir "necesitas minimo en el 60%:", n3_min
	Si n3_min > 5 Entonces
		Escribir "imposible pasar con 5.0"
	FinSi
		

	
FinAlgoritmo
