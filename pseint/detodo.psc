Algoritmo detodolosmetodos
	definir n1,n2,suma,resta,multiplicacion,division como entero;
	
	escribir "digite el primer numero";
	leer n1;
	
	escribir "digite el segundo numero";
	leer n2;
	
	suma=n1+n2;
	resta=n1-n2;
	multiplicacion=n1*n2;
	division=n1/n2;
	
	escribir "el resultado de la suma es:",suma;
	escribir "elresultado de la resta es:",resta;
	escribir "elresultado de la multiplicacion es:",multiplicacion;
	escribir "elresultado de la division es:",division;
	
	
	

	
FinAlgoritmo
